class Solution:
    def peakElement(self, arr):
        n = len(arr)
        low = 0
        high = n - 1

        while low < high:
            mid = (low + high) // 2
            
            # If mid element is smaller than next → peak is on the right side
            if arr[mid] < arr[mid + 1]:
                low = mid + 1
            else:
                # Peak is at mid or on the left
                high = mid
        
        return low      # or high → both are same here
