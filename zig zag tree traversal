'''
class Node:
    def __init__(self, val):
        self.data = val
        self.left = None
        self.right = None
'''
from collections import deque
class Solution:
    def zigZagTraversal(self, root):
        # code here
        q=deque([(root)])
        ans=[]
        count=0
        while (len(q)>0):
            level=[]
            for i in range(len(q)):
                node=q.popleft()
                level.append(node.data)
                if (node.left):
                    q.append(node.left)
                if (node.right):
                    q.append(node.right)
            if (count%2==1):
                ans.extend(level[::-1])
            else:
                ans.extend(level)
            count+=1
        return ans
        
